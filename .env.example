# JARVIS — example environment file
# ===================================================================
# EVERYTHING HERE IS OPTIONAL in the default (bridge) mode. JARVIS runs
# perfectly with an empty file — the bridge authenticates off your Claude Code
# login, and voice input and output both fall back to the browser's own speech.
# Copy this to .env.local, and add only what you actually want to change.
#
# The one line worth adding is ELEVENLABS_API_KEY, down in the BRIDGE section:
# it gives you a much better voice and Scribe transcription. The free tier is
# plenty for a demo. Never commit a real key.
#
# Two audiences read these variables:
#   - the BRIDGE (the Node server, bridge/server.mjs) reads the JARVIS_* and
#     ELEVENLABS_API_KEY variables from its shell environment.
#   - the FRONTEND (the Vite app) reads the VITE_* variables from .env.local.
# Only VITE_-prefixed values ever reach the browser.


# ===================================================================
# BRIDGE (the server) — read from the shell that runs `npm run bridge`
# ===================================================================
# These are shown with their defaults. Leave them unset to accept the default.

# Port the bridge listens on (WebSocket + a few HTTP endpoints). Default 8787.
# If you change it, change VITE_BRIDGE_URL to match.
# JARVIS_BRIDGE_PORT=8787

# The model the bridge asks Claude Code to run. Default claude-opus-5.
# JARVIS_MODEL=claude-opus-5

# Reasoning effort. Default medium.
# JARVIS_EFFORT=medium

# Allow effectful tools (send, tap, delete, install, pay). Off by default, so
# JARVIS can look at anything and change nothing. `npm run bridge:writes` sets
# this to 1 for you — read the decideTool gate in bridge/server.mjs first.
# JARVIS_ALLOW_WRITES=0

# Extra browser origins allowed to open the agent WebSocket, comma separated.
# Local dev origins are already allowed; add others only if you serve the app
# from a different address. Default: none.
# JARVIS_ALLOWED_ORIGINS=

# Allow clients that send no Origin header at all (curl, scripts, native apps).
# Off by default, because that is also what local malware looks like. Default 0.
# JARVIS_ALLOW_NO_ORIGIN=0

# Extra directories the bridge's /file endpoint may serve from, comma separated.
# Your home directory and the system temp directory are always included; this is
# for anything outside them, such as an external drive of footage. Default: none.
# JARVIS_FILE_ROOTS=

# ElevenLabs voice id for the bridge's own speech endpoint. Default: George.
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ElevenLabs API key. Optional. With it, JARVIS speaks in the ElevenLabs voice
# and transcribes with ElevenLabs Scribe; without it, everything still works on
# the browser's own speech. If you already have an elevenlabs MCP server in
# ~/.claude.json, the bridge reads the key from there and you can leave this
# blank. Default: none.
# ELEVENLABS_API_KEY=

# Voice provider routing. Default auto = VoiceStudio when reachable, then ElevenLabs.
# Use voicestudio to force local-first speech, or elevenlabs to force cloud speech.
# TITAN_VOICE_PROVIDER=auto

# VoiceStudio OpenAI-compatible API base. Default http://127.0.0.1:3900.
# Use HTTPS for a non-loopback/remote deployment.
# TITAN_VOICESTUDIO_URL=http://127.0.0.1:3900

# Optional VoiceStudio API key for a remote/private deployment.
# TITAN_VOICESTUDIO_API_KEY=

# Optional VoiceStudio voice profile IDs. Leave unset to use the active/default voice.
# TITAN_VOICESTUDIO_EXECUTIVE_VOICE=
# TITAN_VOICESTUDIO_ALERT_VOICE=
# TITAN_VOICESTUDIO_MODEL=tts-1
# TITAN_VOICESTUDIO_STT_MODEL=whisperx
# TITAN_VOICESTUDIO_TIMEOUT_MS=30000


# ===================================================================
# FRONTEND (Vite) — put these in .env.local
# ===================================================================

# Which brain the browser talks to. Default bridge.
#   bridge — talk to the local bridge (recommended). No API key, and every MCP
#            server in your Claude Code config is available.
#   direct — the browser calls the Claude API itself. Needs VITE_ANTHROPIC_API_KEY.
# VITE_BACKEND=bridge

# Where the bridge listens. Keep the port in step with JARVIS_BRIDGE_PORT above.
# Default ws://localhost:8787.
# VITE_BRIDGE_URL=ws://localhost:8787

# Browser text-to-speech engine, used when no ElevenLabs voice is active.
# Default system.
#   system — the browser's built-in speechSynthesis. Instant, on-device.
#   kokoro — a neural voice running in the browser. Better sound, slower to start.
# VITE_TTS_ENGINE=system

# Which Kokoro voice, when VITE_TTS_ENGINE=kokoro. Default bm_george.
# VITE_KOKORO_VOICE=bm_george

# Prefer the ElevenLabs voice from the browser when a key is available.
# Default false.
# VITE_USE_ELEVENLABS=false

# Anthropic API key — DIRECT MODE ONLY. Required if and only if
# VITE_BACKEND=direct, and it ships to the browser, so use it only for a local
# demo. The default bridge mode never reads it. Default: none.
# VITE_ANTHROPIC_API_KEY=


# ===================================================================
# TITAN AI STACK — optional external services
# ===================================================================

# Ollama local model server (OpenAI-compatible API).
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=

# Activepieces self-hosted API/MCP server.
# TITAN_ACTIVEPIECES_URL=http://127.0.0.1:8080
# TITAN_ACTIVEPIECES_MCP_URL=
# TITAN_ACTIVEPIECES_API_KEY=

# Context Mode agent runtime. Install separately; do not vendor its source.
# TITAN_CONTEXT_MODE_ENABLED=0
# TITAN_CONTEXT_MODE_COMMAND=context-mode

# Everything Claude Code (ECC) agent skill/runtime layer.
# Install separately; do not vendor its source.
# TITAN_ECC_ENABLED=0
# TITAN_ECC_COMMAND=ecc

# Free Claude Code optional local proxy/model router.
# Keep disabled until a local proxy is actually running.
# TITAN_FCC_ENABLED=0
# TITAN_FCC_BASE_URL=
# TITAN_FCC_API_KEY=

# MoneyPrinterTurbo media worker.
# TITAN_MONEYPRINTER_URL=http://127.0.0.1:8080
# TITAN_MONEYPRINTER_API_KEY=

# Open-Generative-AI media studio.
# Set this to the separately deployed service URL when available.
# TITAN_OPEN_GENERATIVE_AI_URL=
# TITAN_OPEN_GENERATIVE_AI_API_KEY=


# n8n workflow automation (alternative to Activepieces).
# TITAN_N8N_URL=http://127.0.0.1:5678
# TITAN_N8N_MCP_URL=
# TITAN_N8N_API_KEY=

# ComfyUI image-generation workflow service.
# TITAN_COMFYUI_URL=http://127.0.0.1:8188
# TITAN_COMFYUI_API_KEY=

# Dify agentic workflow/RAG service.
# TITAN_DIFY_URL=
# TITAN_DIFY_API_KEY=

# Vane self-hosted search/RAG service.
# TITAN_VANE_URL=
# TITAN_VANE_API_KEY=

# LibreChat multi-provider AI workspace.
# TITAN_LIBRECHAT_URL=
# TITAN_LIBRECHAT_API_KEY=

# ===================================================================
# TITAN COMMERCE OS — private bridge
# ===================================================================
# Server-side only. Never expose these through Vite/browser variables.
# TITAN_API_URL=https://your-titan-api.example.com
# TITAN_OWNER_API_TOKEN=
# TITAN_OWNER_STORE_ID=
# TITAN_API_TIMEOUT_MS=15000
