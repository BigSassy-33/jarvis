{
  "version": 1,
  "name": "TITAN AI Stack",
  "policy": {
    "vendorSource": false,
    "secretsFromEnvironment": true,
    "remoteRequiresHttps": true
  },
  "integrations": [
    {
      "id": "nodejs",
      "role": "runtime",
      "protocol": "native",
      "required": true,
      "env": []
    },
    {
      "id": "ollama",
      "role": "local-model-provider",
      "protocol": "openai-http",
      "required": false,
      "env": [
        "OLLAMA_BASE_URL",
        "OLLAMA_MODEL"
      ]
    },
    {
      "id": "activepieces",
      "role": "automation",
      "protocol": "mcp-http",
      "required": false,
      "env": [
        "TITAN_ACTIVEPIECES_URL",
        "TITAN_ACTIVEPIECES_MCP_URL",
        "TITAN_ACTIVEPIECES_API_KEY"
      ]
    },
    {
      "id": "context-mode",
      "role": "context-and-session",
      "protocol": "mcp-stdio-hooks",
      "required": false,
      "env": [
        "TITAN_CONTEXT_MODE_ENABLED",
        "TITAN_CONTEXT_MODE_COMMAND"
      ]
    },
    {
      "id": "ecc",
      "role": "agent-skills-and-verification",
      "protocol": "agent-runtime",
      "required": false,
      "env": [
        "TITAN_ECC_ENABLED",
        "TITAN_ECC_COMMAND"
      ]
    },
    {
      "id": "free-claude-code",
      "role": "optional-model-router",
      "protocol": "local-http-cli",
      "required": false,
      "env": [
        "TITAN_FCC_ENABLED",
        "TITAN_FCC_BASE_URL",
        "TITAN_FCC_API_KEY"
      ]
    },
    {
      "id": "moneyprinterturbo",
      "role": "short-video-worker",
      "protocol": "http-api",
      "required": false,
      "env": [
        "TITAN_MONEYPRINTER_URL",
        "TITAN_MONEYPRINTER_API_KEY"
      ]
    },
    {
      "id": "open-generative-ai",
      "role": "image-video-cinema-worker",
      "protocol": "service-boundary",
      "required": false,
      "env": [
        "TITAN_OPEN_GENERATIVE_AI_URL",
        "TITAN_OPEN_GENERATIVE_AI_API_KEY"
      ]
    },
    {
      "id": "voicestudio",
      "role": "local-stt-tts",
      "protocol": "openai-http",
      "required": false,
      "env": [
        "TITAN_VOICE_PROVIDER",
        "TITAN_VOICESTUDIO_URL",
        "TITAN_VOICESTUDIO_API_KEY"
      ]
    },
    {
      "id": "elevenlabs",
      "role": "cloud-stt-tts-fallback",
      "protocol": "https-api",
      "required": false,
      "env": [
        "ELEVENLABS_API_KEY",
        "TITAN_EXECUTIVE_VOICE_ID",
        "TITAN_ALERT_VOICE_ID"
      ]
    }
  ]
}
